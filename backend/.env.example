# Copy this file to .env in the backend/ folder and fill in your keys.
# .env is for local use only -- never commit it (see PRODUCTION_MANIFEST.md's
# "Do Not Commit Or Share" rule, which applies to these keys too).

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Optional: user accounts, MFA, and subscription gating (OFF by default).
# The app works exactly as it does today until you fill these in AND set
# AUTH_ENABLED=true below. See the "User accounts, MFA & subscription
# gating" section of the roadmap doc for the full setup walkthrough (create
# a Supabase project, turn on email+password + TOTP MFA, create a Stripe
# account + subscription product, point a webhook at
# https://<your-domain>/api/billing/webhook).
# ---------------------------------------------------------------------------
AUTH_ENABLED=false

# From your Supabase project's Settings -> API page.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
# Settings -> API -> JWT Settings -> JWT Secret (keep this one secret --
# unlike the anon key, it must never reach the browser).
SUPABASE_JWT_SECRET=

# From your Stripe Dashboard -> Developers -> API keys (use a secret key,
# not a publishable one) and -> Webhooks -> your endpoint's Signing secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
